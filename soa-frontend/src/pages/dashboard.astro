---
// src/pages/dashboard.astro
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="SOA Dashboard">
  <style>
    @keyframes fade-up { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .fade-up { animation: fade-up 0.3s ease-out both; }
    .grid-bg {
      background-image: linear-gradient(rgba(249,115,22,0.02) 1px, transparent 1px), linear-gradient(90deg, rgba(249,115,22,0.02) 1px, transparent 1px);
      background-size: 40px 40px;
    }
    
    .tab-btn { color: rgba(255,255,255,0.5); border-bottom: 2px solid transparent; transition: all 0.2s; }
    .tab-btn:hover { color: white; }
    .tab-btn.active { color: #f97316; border-bottom: 2px solid #f97316; }
    
    .card-panel { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; padding: 20px; }
    .input-sm { background: rgba(0,0,0,0.2); border: 1px solid rgba(255,255,255,0.1); color: white; border-radius: 6px; padding: 6px 12px; outline: none; }
    .btn-sm { background: #f97316; color: white; padding: 6px 12px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; border: none; }
    .btn-sm:hover { background: #ea580c; }
    
    table { width: 100%; border-collapse: collapse; font-family: 'DM Mono', monospace; font-size: 13px; }
    th, td { text-align: left; padding: 10px; border-bottom: 1px solid rgba(255,255,255,0.05); }
    th { color: rgba(255,255,255,0.4); font-weight: normal; }
    td { color: white; }
  </style>

  <nav class="sticky top-0 z-50 border-b border-white/10 bg-zinc-950/80 backdrop-blur-md">
    <div class="mx-auto max-w-7xl px-4 h-14 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <span class="font-bold text-white font-['Syne']">ShopNow SOA</span>
        <div id="connection-status" class="flex items-center gap-2 text-xs font-mono text-white/40 ml-4">
          <span id="status-dot" class="w-2 h-2 rounded-full bg-zinc-600"></span>
          <span id="status-text">Conectando...</span>
        </div>
      </div>
      <div class="flex items-center gap-4">
        <span id="nav-username" class="text-xs font-mono text-white/40"></span>
        <button id="logout-btn" class="text-xs border border-white/10 text-white/50 px-3 py-1.5 rounded hover:text-white transition">Salir</button>
      </div>
    </div>
  </nav>

  <div class="bg-zinc-900/50 border-b border-white/10">
    <div class="mx-auto max-w-7xl px-4 flex gap-6 font-['DM_Sans'] text-sm">
      <button class="tab-btn active py-3" data-target="view-productos">📦 Productos (8001)</button>
      <button class="tab-btn py-3" data-target="view-clientes">👥 Clientes (8000)</button>
      <button class="tab-btn py-3" data-target="view-inventario">warehouse Inventario (8003)</button>
      <button class="tab-btn py-3" data-target="view-pedidos">🛒 Pedidos (8002)</button>
    </div>
  </div>

  <main class="grid-bg min-h-screen py-8">
    <div class="mx-auto max-w-7xl px-4">
      
      <section id="view-productos" class="tab-content fade-up">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-white font-['Syne']">Catálogo Oficial</h2>
          <form id="form-producto" class="flex gap-2">
            <input type="text" id="p-desc" placeholder="Nombre..." class="input-sm text-sm" required>
            <input type="number" id="p-precio" placeholder="Precio $" class="input-sm text-sm w-24" required>
            <button type="submit" class="btn-sm">Crear Producto</button>
          </form>
        </div>
        <div id="productos-grid" class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4"></div>
      </section>

      <section id="view-clientes" class="tab-content hidden fade-up">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-white font-['Syne']">Padrón de Clientes</h2>
          <form id="form-cliente" class="flex gap-2">
            <input type="text" id="c-nombre" placeholder="Nombre completo" class="input-sm text-sm" required>
            <input type="email" id="c-correo" placeholder="Email" class="input-sm text-sm" required>
            <button type="submit" class="btn-sm">Registrar Cliente</button>
          </form>
        </div>
        <div class="card-panel overflow-x-auto">
          <table>
            <thead><tr><th>ID</th><th>Nombre</th><th>Correo</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody id="clientes-tbody"></tbody>
          </table>
        </div>
      </section>

      <section id="view-inventario" class="tab-content hidden fade-up">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold text-white font-['Syne']">Almacén Físico</h2>
          <form id="form-inventario" class="flex gap-2">
            <input type="number" id="i-id" placeholder="ID Prod." class="input-sm text-sm w-24" required>
            <input type="number" id="i-stock" placeholder="Stock Inicial" class="input-sm text-sm w-24" required>
            <button type="submit" class="btn-sm">Dar de alta en Almacén</button>
          </form>
        </div>
        <div class="card-panel overflow-x-auto">
          <table>
            <thead><tr><th>ID Producto</th><th>Stock Disponible</th><th>Estado</th><th>Acciones</th></tr></thead>
            <tbody id="inventario-tbody"></tbody>
          </table>
        </div>
      </section>

      <section id="view-pedidos" class="tab-content hidden fade-up">
        <div class="mb-8 p-6 rounded-2xl border border-orange-500/30 bg-orange-500/5">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-lg font-bold text-orange-400 font-['Syne'] flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
              Simulador del Orquestador (Nueva Orden)
            </h2>
          </div>
          <form id="form-pedido" class="flex gap-4 items-end">
            <div class="flex-1">
              <label class="block text-xs text-white/50 mb-1">ID Cliente (Padrón)</label>
              <input type="number" id="ped-cli" class="input-sm w-full" required>
            </div>
            <div class="flex-1">
              <label class="block text-xs text-white/50 mb-1">ID Producto (Catálogo)</label>
              <input type="number" id="ped-prod" class="input-sm w-full" required>
            </div>
            <div class="flex-1">
              <label class="block text-xs text-white/50 mb-1">Cantidad a Comprar</label>
              <input type="number" id="ped-cant" class="input-sm w-full" required>
            </div>
            <button type="submit" class="btn-sm px-6 h-[34px] bg-orange-600 hover:bg-orange-500 shadow-lg shadow-orange-500/20">
              Encolar a RabbitMQ
            </button>
          </form>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
          <div>
            <h2 class="text-md font-bold text-white mb-4 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-green-500"></span>
              Ventas Procesadas Exitosamente
            </h2>
            <div class="card-panel overflow-x-auto p-0">
              <table class="w-full text-left border-collapse">
                <thead><tr class="bg-white/5"><th class="p-3 text-xs text-white/40 font-normal">ID Pedido</th><th class="p-3 text-xs text-white/40 font-normal">Cli/Prod</th><th class="p-3 text-xs text-white/40 font-normal">Cant</th><th class="p-3 text-xs text-white/40 font-normal">Total</th><th class="p-3 text-xs text-white/40 font-normal">Acción</th></tr></thead>
                <tbody id="pedidos-tbody"></tbody>
              </table>
            </div>
          </div>

          <div>
            <h2 class="text-md font-bold text-white mb-4 flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-red-500"></span>
              Pedidos Retenidos (Simulación de Caos)
            </h2>
            <div class="card-panel overflow-x-auto p-0 border-red-500/20">
              <table class="w-full text-left border-collapse">
                <thead><tr class="bg-red-500/5"><th class="p-3 text-xs text-red-400/50 font-normal">Cliente</th><th class="p-3 text-xs text-red-400/50 font-normal">Producto</th><th class="p-3 text-xs text-red-400/50 font-normal">Cant</th><th class="p-3 text-xs text-red-400/50 font-normal">Motivo del Rechazo</th></tr></thead>
                <tbody id="pedidos-pendientes-tbody"></tbody>
              </table>
            </div>
          </div>
        </div>

      </section>

    </div>
  </main>
</BaseLayout>

<script>
  import { 
    isLoggedIn, clearToken, getUsername, 
    getProductos, crearProducto, updateProducto, deleteProducto,
    getClientes, crearCliente, updateCliente, deleteCliente,
    getInventario, initInventario, updateInventario, deleteInventario,
    getPedidos, getPedidosPendientes, crearPedido, cancelarPedido
  } from '../lib/api.ts';

  // Seguridad: Redirigir si no hay token
  if (!isLoggedIn()) window.location.replace('/');
  document.getElementById('nav-username')!.textContent = getUsername();

  // ==========================================
  // UI CONTROLS Y TABS
  // ==========================================
  function setStatus(online: boolean) {
    const dot = document.getElementById('status-dot')!;
    const txt = document.getElementById('status-text')!;
    dot.style.background = online ? '#10b981' : '#ef4444';
    dot.style.boxShadow = online ? '0 0 6px #10b981' : '0 0 6px #ef4444';
    txt.textContent = online ? 'Sistemas en línea' : 'Error de conexión';
    txt.style.color = online ? '#6ee7b7' : '#fca5a5';
  }

  const tabs = document.querySelectorAll('.tab-btn');
  const sections = document.querySelectorAll('.tab-content');
  
  tabs.forEach(tab => {
    tab.addEventListener('click', (e) => {
      tabs.forEach(t => t.classList.remove('active'));
      sections.forEach(s => s.classList.add('hidden'));
      
      const target = (e.target as HTMLElement).getAttribute('data-target')!;
      (e.target as HTMLElement).classList.add('active');
      document.getElementById(target)!.classList.remove('hidden');
    });
  });

  // ==========================================
  // CARGA CENTRAL DE DATOS
  // ==========================================
  async function loadAllData() {
    try {
      setStatus(true);
      
      // 1. Cargar Productos (8001)
      const productos = await getProductos();
      const pGrid = document.getElementById('productos-grid')!;
      pGrid.innerHTML = productos.map(p => `
        <div class="card-panel flex flex-col gap-3">
          <div class="flex justify-between items-start">
            <div>
              <span class="text-xs text-white/30">ID #${p.id_producto}</span>
              <h3 class="text-white font-bold">${p.descripcion}</h3>
            </div>
            <button onclick="eliminarProducto(${p.id_producto})" class="text-red-500 hover:text-red-400" title="Eliminar">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
            </button>
          </div>
          <p class="text-xl font-mono text-orange-500">$${p.precio}</p>
          <div class="mt-auto">
            <button onclick="prepararEdicion(${p.id_producto}, '${p.descripcion}', ${p.precio})" class="btn-sm w-full bg-zinc-700 hover:bg-zinc-600">
              Editar Datos
            </button>
          </div>
        </div>
      `).join('') || '<p class="text-white/40 text-sm">No hay productos activos.</p>';

      // 2. Cargar Clientes (8000)
      const clientes = await getClientes();
      document.getElementById('clientes-tbody')!.innerHTML = clientes.map(c => `
        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors ${!c.activo ? 'opacity-50 grayscale' : ''}">
          <td class="py-3 px-4 font-mono text-white/50">#${c.id_cliente}</td>
          <td class="py-3 px-4 font-medium text-white">${c.nombre}</td>
          <td class="py-3 px-4 text-white/70">${c.correo}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-1 rounded-md text-xs font-medium ${c.activo ? 'bg-green-500/10 text-green-400 border border-green-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'}">
              ${c.activo ? '● Activo' : '○ Inactivo'}
            </span>
          </td>
          <td class="py-3 px-4">
            <div class="flex items-center gap-2">
              <button onclick="prepararEdicionCliente(${c.id_cliente}, '${c.nombre}', '${c.correo}')" 
                      class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-blue-500/10 text-blue-400 hover:bg-blue-500/20 border border-transparent hover:border-blue-500/30 transition-all text-xs font-semibold" 
                      ${!c.activo ? 'disabled' : ''} title="Editar">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" /></svg>
                Editar
              </button>
              <button onclick="eliminarCliente(${c.id_cliente})" 
                      class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-transparent hover:border-red-500/30 transition-all text-xs font-semibold" 
                      ${!c.activo ? 'disabled' : ''} title="Dar de baja">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Baja
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      // 3. Cargar Inventario (8003)
      const inventario = await getInventario();
      document.getElementById('inventario-tbody')!.innerHTML = inventario.map(i => `
        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
          <td class="py-3 px-4 font-mono text-white/50">#${i.id_producto}</td>
          <td class="py-3 px-4 font-bold ${i.stock > 0 ? 'text-white' : 'text-red-400'}">${i.stock} unids.</td>
          <td class="py-3 px-4">
            <span class="px-2 py-1 rounded-md text-xs font-medium ${i.stock > 0 ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20' : 'bg-red-500/10 text-red-400 border border-red-500/20'}">
              ${i.stock > 0 ? '● En Almacén' : '○ Agotado'}
            </span>
          </td>
          <td class="py-3 px-4">
            <div class="flex items-center gap-2">
              <button onclick="prepararEdicionInventario(${i.id_producto}, ${i.stock})" 
                      class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-orange-500/10 text-orange-400 hover:bg-orange-500/20 border border-transparent hover:border-orange-500/30 transition-all text-xs font-semibold" 
                      title="Ajustar Stock">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" /></svg>
                Ajustar
              </button>
              <button onclick="eliminarInventario(${i.id_producto})" 
                      class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-500/20 border border-transparent hover:border-red-500/30 transition-all text-xs font-semibold" 
                      title="Quitar registro">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                Quitar
              </button>
            </div>
          </td>
        </tr>
      `).join('');

      // 4. Cargar Pedidos y Caos (8002)
      const pedidos = await getPedidos();
      document.getElementById('pedidos-tbody')!.innerHTML = pedidos.map(p => `
        <tr class="border-b border-white/5 hover:bg-white/[0.02]">
          <td class="p-3 font-mono text-white/50 text-xs">#${p.id_pedido}</td>
          <td class="p-3 text-white text-xs">C:${p.id_cliente} / P:${p.id_producto}</td>
          <td class="p-3 text-white text-xs">${p.cantidad}</td>
          <td class="p-3 font-bold ${p.estado === 'Cancelado' ? 'text-white/30 line-through' : 'text-green-400'} text-xs">$${p.total}</td>
          <td class="p-3">
            <button onclick="cancelarPedidoId(${p.id_pedido})" class="text-red-400 hover:text-red-300 text-xs font-bold" ${p.estado === 'Cancelado' ? 'disabled' : ''}>
              ${p.estado === 'Cancelado' ? 'Cancelado' : 'Cancelar'}
            </button>
          </td>
        </tr>
      `).join('');

      const pendientes = await getPedidosPendientes();
      document.getElementById('pedidos-pendientes-tbody')!.innerHTML = pendientes.map(p => `
        <tr class="border-b border-red-500/10 bg-red-500/5">
          <td class="p-3 font-mono text-white text-xs">#${p.id_cliente}</td>
          <td class="p-3 font-mono text-white text-xs">#${p.id_producto}</td>
          <td class="p-3 text-white text-xs">${p.cantidad}</td>
          <td class="p-3 text-red-400 text-xs font-bold flex items-center gap-1">
            <svg class="w-3 h-3 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" /></svg>
            ${p.motivo}
          </td>
        </tr>
      `).join('');

    } catch (err) {
      setStatus(false);
      console.error(err);
    }
  }

  // ==========================================
  // LÓGICA CRUD: PRODUCTOS
  // ==========================================
  let productoEnEdicion: number | null = null;

  (window as any).prepararEdicion = (id: number, desc: string, precio: number) => {
    productoEnEdicion = id;
    (document.getElementById('p-desc') as HTMLInputElement).value = desc;
    (document.getElementById('p-precio') as HTMLInputElement).value = precio.toString();
    const btn = document.querySelector('#form-producto button')!;
    btn.textContent = 'Guardar Cambios';
    btn.classList.replace('bg-orange-500', 'bg-blue-500');
  };

  (window as any).eliminarProducto = async (id: number) => {
    if (confirm(`¿Estás seguro de dar de baja el producto #${id}?`)) {
      try {
        await deleteProducto(id);
        loadAllData();
      } catch(e) { alert("Error al eliminar."); }
    }
  };

  document.getElementById('form-producto')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const desc = (document.getElementById('p-desc') as HTMLInputElement).value;
    const precio = parseFloat((document.getElementById('p-precio') as HTMLInputElement).value);
    
    try {
      if (productoEnEdicion) {
        await updateProducto(productoEnEdicion, desc, precio);
        productoEnEdicion = null;
        const btn = document.querySelector('#form-producto button')!;
        btn.textContent = 'Crear Producto';
        btn.classList.replace('bg-blue-500', 'bg-orange-500');
      } else {
        await crearProducto(desc, precio);
      }
      (e.target as HTMLFormElement).reset();
      loadAllData();
    } catch(err) { alert("Error al guardar el producto."); }
  });

  // ==========================================
  // LÓGICA CRUD: CLIENTES
  // ==========================================
  let clienteEnEdicion: number | null = null;

  (window as any).prepararEdicionCliente = (id: number, nombre: string, correo: string) => {
    clienteEnEdicion = id;
    (document.getElementById('c-nombre') as HTMLInputElement).value = nombre;
    (document.getElementById('c-correo') as HTMLInputElement).value = correo;
    const btn = document.querySelector('#form-cliente button')!;
    btn.textContent = 'Guardar Cambios';
    btn.classList.replace('bg-orange-500', 'bg-blue-500');
  };

  (window as any).eliminarCliente = async (id: number) => {
    if (confirm(`¿Estás seguro de dar de baja al cliente #${id}?`)) {
      try {
        await deleteCliente(id);
        loadAllData();
      } catch(e) { alert("Error al eliminar."); }
    }
  };

  const formCliente = document.getElementById('form-cliente');
  if(formCliente) {
    const nuevoFormCliente = formCliente.cloneNode(true);
    formCliente.parentNode!.replaceChild(nuevoFormCliente, formCliente);
    nuevoFormCliente.addEventListener('submit', async (e) => {
      e.preventDefault();
      const nombre = (document.getElementById('c-nombre') as HTMLInputElement).value;
      const correo = (document.getElementById('c-correo') as HTMLInputElement).value;
      
      try {
        if (clienteEnEdicion) {
          await updateCliente(clienteEnEdicion, nombre, correo);
          clienteEnEdicion = null;
          const btn = document.querySelector('#form-cliente button')!;
          btn.textContent = 'Registrar Cliente';
          btn.classList.replace('bg-blue-500', 'bg-orange-500');
        } else {
          await crearCliente(nombre, correo);
        }
        (e.target as HTMLFormElement).reset();
        loadAllData();
      } catch(err) { alert("Error al guardar cliente."); }
    });
  }

  // ==========================================
  // LÓGICA CRUD: INVENTARIO
  // ==========================================
  let inventarioEnEdicion: number | null = null;

  (window as any).prepararEdicionInventario = (id_producto: number, stock: number) => {
    inventarioEnEdicion = id_producto;
    const inputId = document.getElementById('i-id') as HTMLInputElement;
    const inputStock = document.getElementById('i-stock') as HTMLInputElement;
    
    inputId.value = id_producto.toString();
    inputId.disabled = true;
    inputId.classList.add('opacity-50');
    
    inputStock.value = stock.toString();
    inputStock.focus();
    
    const btn = document.querySelector('#form-inventario button')!;
    btn.textContent = 'Guardar Ajuste';
    btn.classList.replace('bg-orange-500', 'bg-blue-500');
  };

  (window as any).eliminarInventario = async (id_producto: number) => {
    if (confirm(`¿Estás seguro de eliminar el registro de almacén para el producto #${id_producto}?`)) {
      try {
        await deleteInventario(id_producto);
        loadAllData();
      } catch(e) { alert("Error al eliminar el registro."); }
    }
  };

  const formInventario = document.getElementById('form-inventario');
  if(formInventario) {
    const nuevoFormInventario = formInventario.cloneNode(true);
    formInventario.parentNode!.replaceChild(nuevoFormInventario, formInventario);
    nuevoFormInventario.addEventListener('submit', async (e) => {
      e.preventDefault();
      const idProd = parseInt((document.getElementById('i-id') as HTMLInputElement).value);
      const stock = parseInt((document.getElementById('i-stock') as HTMLInputElement).value);
      
      try {
        if (inventarioEnEdicion) {
          await updateInventario(inventarioEnEdicion, stock);
          inventarioEnEdicion = null;
          
          const inputId = document.getElementById('i-id') as HTMLInputElement;
          inputId.disabled = false;
          inputId.classList.remove('opacity-50');
          
          const btn = document.querySelector('#form-inventario button')!;
          btn.textContent = 'Dar de alta en Almacén';
          btn.classList.replace('bg-blue-500', 'bg-orange-500');
        } else {
          await initInventario(idProd, stock);
        }
        (e.target as HTMLFormElement).reset();
        loadAllData();
      } catch(err) { alert("Error al guardar inventario."); }
    });
  }

  // ==========================================
  // LÓGICA CRUD: PEDIDOS (ORQUESTADOR)
  // ==========================================
  (window as any).cancelarPedidoId = async (id: number) => {
    if (confirm(`¿Marcar el pedido #${id} como Cancelado?`)) {
      try {
        await cancelarPedido(id);
        loadAllData();
      } catch(e) { alert("Error al cancelar."); }
    }
  };

  document.getElementById('form-pedido')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = {
      id_cliente: parseInt((document.getElementById('ped-cli') as HTMLInputElement).value),
      id_producto: parseInt((document.getElementById('ped-prod') as HTMLInputElement).value),
      cantidad: parseInt((document.getElementById('ped-cant') as HTMLInputElement).value)
    };
    try {
      await crearPedido(payload);
      alert("✅ ¡Petición enviada a RabbitMQ!\n\nEl orquestador en segundo plano está validando con Clientes, Productos e Inventario. La tabla se actualizará en 3 segundos.");
      (e.target as HTMLFormElement).reset();
      // Esperamos a que RabbitMQ y los demás microservicios terminen antes de recargar la vista
      setTimeout(loadAllData, 3000); 
    } catch(err) { alert("Error al comunicarse con RabbitMQ."); }
  });

  // ==========================================
  // CERRAR SESIÓN E INICIO
  // ==========================================
  document.getElementById('logout-btn')?.addEventListener('click', () => {
    clearToken(); 
    window.location.replace('/');
  });

  // Ejecutamos la carga inicial al entrar
  loadAllData();
</script>